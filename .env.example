# PostgreSQL
POSTGRES_DB=exambank_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Spring Boot / OpenAI
OPENAI_API_KEY=CHANGE_ME
APP_AUTH_USERNAME=expert
APP_AUTH_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Optional tuning
JPA_DDL_AUTO=update

# NCERT production corpus
NCERT_CORPUS_VERSION=2026
NCERT_CHUNK_VERSION=v1
NCERT_CHUNK_SIZE=500
NCERT_CHUNK_OVERLAP=80
NCERT_INGESTION_BATCH_SIZE=50
NCERT_INGESTION_FAIL_FAST=false
NCERT_ADMIN_INGESTION_ENABLED=false

# Required only when starting the public Caddy profile
APP_DOMAIN=examsetter.example.com
